import os

users = [
    ["admin", "admin123", "admin"],
    ["user1", "user123", "user"]
]

data_akun = [
    ["MLBB", "Lebron_James", "BronBronny"]
]

logged_in_user = ""
logged_in_role = ""


while True:
    os.system('cls' if os.name == 'nt' else 'clear')
    print("===========================")
    print("  ACCOUNT MANAGER - LOGIN  ")
    print("===========================")
    print("1. Login")
    print("2. Register (jika belum mempunyai akun)")
    print("3. Keluar program")
    print("===========================")
    print("")

    pilihan_awal = input("Pilih menu (1-3): ").strip()

    if pilihan_awal == "1":
        print("===========================")
        print("           LOGIN           ")
        print("===========================")
        input_user = input("Username : ").strip()
        input_pass = input("Password : ").strip()

        user_ditemukan = False
        for user in users:
            if user[0] == input_user and user[1] == input_pass:
                logged_in_user = user[0]
                logged_in_role = user[2]
                user_ditemukan = True
                break
            
        if user_ditemukan:
            print(f"Login berhasil! Selamat datang {logged_in_user}! role kamu '{logged_in_role.upper()}' ya!")
            input("Tekan Enter untuk melanjutkan.")
            break
        else:
            print("Username atau password salah!")
            input("Tekan Enter untuk mencoba lagi.")

    elif pilihan_awal == "2":
        print(" REGISTER PENGGUNA ")
        reg_user = input("Masukkan Username Baru: ").strip()
        reg_pass = input("Masukkan Password Baru: ").strip()

        if reg_user != "" and reg_pass != "":
            sudah_ada = False
            for user in users:
                if user[0] == reg_user:
                    sudah_ada = True
                    break

            if sudah_ada:
                print("Username sudah terdaftar! Mohon gunakan username lain ^^.")
            else:    
                # Fix Bug #1: Simpan user baru ke database
                users.append([reg_user, reg_pass, "user"])
                print(f"Registrasi berhasil! Akun '{reg_user}' telah dibuat.")
        else:
            print("Username dan password tidak boleh kosong!")

        input("Tekan Enter untuk kembali ke menu utama.")

    elif pilihan_awal == "3":
        print("Terima Kasih sudah menggunakan program ini!")
        exit()
    else:
        print("Pilihan invalid")
        input("Tekan Enter untuk mencoba lagi.")


while True:
    os.system('cls' if os.name == 'nt' else 'clear')
    print("===========================")
    print(" ACCOUNT MANAGER - MAIN MENU ")
    print("===========================")
    print(f"Pengguna Aktif : {logged_in_user}")
    print("===========================")

    if logged_in_role == "admin":
        print("1. Tambah Akun Baru (Create)")
        print("2. Lihat Semua Akun (Read)")
        print("3. Perbarui Password Akun (Update)")
        print("4. Hapus Akun (Delete)")
        print("5. Logout")
    else:
        print("1. Lihat Semua Akun (Read - Akses Terbatas)")
        print("2. Logout")
    
    print("===========================")

    pilihan_menu = input("Pilih menu: ").strip()

    if logged_in_role == "admin":
        if pilihan_menu == "1":
            os.system('cls' if os.name == 'nt' else 'clear')
            print("===========================")
            print("     TAMBAH AKUN BARU      ")
            print("===========================")
            app = input("Nama Aplikasi / Web : ").strip()
            uname = input("Username / Email    : ").strip()
            pwd = input("Password            : ").strip()

            if app != "" and uname != "" and pwd != "":
                data_akun.append([app, uname, pwd])
                print(f"Kredensial untuk '{app}' berhasil ditambahkan!")
            else:
                print("Mohon mengisi semua data!")
            input("Tekan Enter untuk kembali.")

        elif pilihan_menu == "2":
            os.system('cls' if os.name == 'nt' else 'clear')
            print("===========================")
            print("        LIST AKUN          ")
            print("===========================")
            if len(data_akun) == 0:
                print("Belum ada data akun yang tersimpan di database.")
            else:
                print(f"{'No.':<4} | {'Aplikasi / Web':<20} | {'Username / Email':<20} | {'Password':<15}")
                print("===================================================================")
                index = 1
                for item in data_akun:
                    # Fix Bug #2: Sertakan item[1] untuk mencetak Username
                    print(f"{index:<4} | {item[0]:<20} | {item[1]:<20} | {item[2]:<15}")
                    index += 1
            input("Tekan Enter untuk kembali.")

        elif pilihan_menu == "3":
            os.system('cls' if os.name == 'nt' else 'clear')
            print("===========================")
            print("   UPDATE PASSWORD AKUN    ")
            print("===========================")
            if len(data_akun) == 0:
                print("Belum ada data akun yang tersimpan di database.")
            else:
                print(f"{'No.':<4} | {'Aplikasi / Web':<20} | {'Username / Email':<20}")
                print("==================================================")
                idx = 1
                for item in data_akun:
                    print(f"{idx:<4} | {item[0]:<20} | {item[1]:<20}")
                    idx += 1
                print("==================================================")

                input_no = input("Masukkan Nomor Akun yang ingin diubah password-nya: ").strip()

                if input_no.isdigit():
                    no_index = int(input_no) - 1
                    if 0 <= no_index < len(data_akun):
                        pass_baru = input(f"Masukkan Password Baru untuk '{data_akun[no_index][0]}': ").strip()
                        if pass_baru != "":
                            data_akun[no_index][2] = pass_baru
                            print("Password berhasil diperbarui!")
                        else:
                            print("Password baru tidak boleh kosong!")
                    else:
                        print("Nomor akun tidak ditemukan!")
                else:
                    print("Input harus berupa angka nomor akun!")
            input("Tekan Enter untuk kembali.")

        elif pilihan_menu == "4":
            os.system('cls' if os.name == 'nt' else 'clear')
            print("===========================")
            print("        DELETE AKUN        ")
            print("===========================")
            if len(data_akun) == 0:
                print("Belum ada data akun yang tersimpan di database.")
            else:
                # Fix Bug #3: Ganti 'item'[1] menjadi header string "Username / Email"
                print(f"{'No.':<4} | {'Aplikasi / Web':<20} | {'Username / Email':<20}")
                print("==================================================")
                idx = 1
                for item in data_akun:
                    print(f"{idx:<4} | {item[0]:<20} | {item[1]:<20}")
                    idx += 1
                print("==================================================")

                input_no = input("Masukkan Nomor Akun yang ingin dihapus: ").strip()

                if input_no.isdigit():
                    no_index = int(input_no) - 1
                    if 0 <= no_index < len(data_akun):
                        akun_terhapus = data_akun.pop(no_index)
                        print(f"Akun '{akun_terhapus[0]}' ({akun_terhapus[1]}) berhasil dihapus!")
                    else:
                        print("Nomor akun tidak ditemukan!")
                else:
                    print("Input harus berupa angka nomor akun!")
            
            # Fix Bug #4: Keluarkan input() dari else agar selalu menahan layar
            input("Tekan Enter untuk kembali.")

        elif pilihan_menu == "5":
            print("Berhasil logout dari sistem.")
            logged_in_user = ""
            logged_in_role = ""
            input("Tekan Enter untuk kembali ke halaman utama.")
            break
        else:
            print("Pilihan invalid!")
            input("Tekan Enter untuk mencoba lagi.")

    else:
        if pilihan_menu == "1":
            os.system('cls' if os.name == 'nt' else 'clear')
            print("===========================")
            print("        DAFTAR AKUN        ")
            print("===========================")
            if len(data_akun) == 0:
                print("Belum ada data akun yang tersimpan di database.")
            else:
                print(f"{'No.':<4} | {'Aplikasi / Web':<20} | {'Username / Email':<20}")
                print("--------------------------------------------------")
                index = 1
                for item in data_akun:
                    print(f"{index:<4} | {item[0]:<20} | {item[1]:<20}")
                    index += 1
            input("Tekan Enter untuk kembali.")

        elif pilihan_menu == "2":
            print("Berhasil logout dari sistem.")
            logged_in_user = ""
            logged_in_role = ""
            input("Tekan Enter untuk kembali ke halaman utama.")
            break
        else:
            print("Pilihan Invalid!")
            input("Tekan Enter untuk mencoba lagi.")