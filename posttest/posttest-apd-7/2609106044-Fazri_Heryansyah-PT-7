def hitung_total_akun_rekursif(daftar_kunci, index=0):
    if index >= len(daftar_kunci):
        return 0
    return 1 + hitung_total_akun_rekursif(daftar_kunci, index + 1)

def validasi_pilihan_menu(max_pilihan):
    try:
        input_str = input("Pilih menu: (1-3): ").strip()
        pilihan_angka = int(input_str)
        if 1 <= pilihan_angka <= max_pilihan:
            return pilihan_angka
        else:
            print("\nPilihan menu tidak tersedia!")
            input("Tekan Enter untuk mencoba lagi.")
            return None
    except ValueError:
        print("\nError: Input harus berupa angka!")
        input("Tekan Enter untuk mencoba lagi.")
        return None

